{
  "name": "canvas-work-manager-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,host --prefix-colors cyan,magenta \"pnpm dev:web\" \"pnpm dev:host\"",
    "dev:web": "pnpm --filter web start",
    "dev:host": "pnpm --filter @cwm/prototype-host dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "prototype:seed": "pnpm --filter @cwm/prototype-data seed",
    "prototype:reset": "pnpm --filter @cwm/prototype-data seed personal-workspace"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "~6.0.2"
  }
}
