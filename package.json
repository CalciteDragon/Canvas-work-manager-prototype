{
  "name": "canvas-work-manager-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter web start",
    "dev:host": "pnpm --filter @cwm/prototype-host dev",
    "build": "pnpm -r --if-present build",
    "test": "node --test scripts/roadmap.test.mjs scripts/check-docs.test.mjs && pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint && node scripts/check-docs.mjs",
    "prototype:seed": "pnpm --filter @cwm/prototype-data seed",
    "prototype:reset": "pnpm --filter @cwm/prototype-data seed personal-workspace",
    "prototype:upgrade": "pnpm --filter @cwm/prototype-data upgrade-data",
    "mcp:stdio": "pnpm --silent --filter @cwm/prototype-host mcp:stdio",
    "e2e": "pnpm --filter @cwm/e2e e2e",
    "storybook": "pnpm --filter web storybook",
    "storybook:build": "pnpm --filter web storybook:build",
    "docs:api": "compodoc -p tsconfig.compodoc.json -d docs/api --silent --disableSourceCode",
    "docs:api:serve": "compodoc -p tsconfig.compodoc.json -d docs/api --silent --disableSourceCode -s -r 4320",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:site": "node scripts/docs-site-assets.mjs && vitepress dev",
    "docs:site:build": "pnpm docs:api && node scripts/docs-site-assets.mjs && vitepress build",
    "docs:site:preview": "vitepress preview"
  },
  "devDependencies": {
    "@compodoc/compodoc": "2.0.0",
    "jsdom": "^28.1.0",
    "mermaid": "^11.17.2",
    "typescript": "~6.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
