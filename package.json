{
  "name": "canvas-work-manager-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter web start",
    "dev:host": "pnpm --filter @cwm/prototype-host dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "prototype:seed": "pnpm --filter @cwm/prototype-data seed",
    "prototype:reset": "pnpm --filter @cwm/prototype-data seed personal-workspace",
    "prototype:upgrade": "pnpm --filter @cwm/prototype-data upgrade-data",
    "mcp:stdio": "pnpm --silent --filter @cwm/prototype-host mcp:stdio",
    "e2e": "pnpm --filter @cwm/e2e e2e",
    "storybook": "pnpm --filter web storybook",
    "storybook:build": "pnpm --filter web storybook:build"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
