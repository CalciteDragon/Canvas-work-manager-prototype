{
  "name": "@cwm/prototype-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch main.ts",
    "start": "tsx main.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "acceptance": "node scripts/acceptance.mjs",
    "agent-acceptance": "node scripts/agent-acceptance.mjs",
    "mcp:stdio": "tsx mcp/stdio.ts",
    "mcp-acceptance": "node --import tsx scripts/mcp-acceptance.mjs",
    "live-acceptance": "node --import tsx scripts/live-acceptance.mjs"
  },
  "dependencies": {
    "@cwm/contracts": "workspace:*",
    "@cwm/domain": "workspace:*",
    "@cwm/mcp-tools": "workspace:*",
    "@cwm/prototype-data": "workspace:*",
    "@cwm/repositories": "workspace:*",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
