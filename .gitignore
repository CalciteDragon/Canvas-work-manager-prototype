# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
out-tsc/
.angular/
.angular-test-temp/
apps/web/storybook-static/

# Runtime data, ownership records, caches and disposable audit scratch work stay local.
# Friction notes are project evidence; seeds under prototype/seeds/ are committed too.
.prototype/*
!.prototype/.gitkeep
!.prototype/notes.json

# Playwright's generated output.
apps/e2e/test-results/
apps/e2e/playwright-report/

# Editors / OS
.idea/
.claude/settings.local.json
.DS_Store
Thumbs.db
*.log

# Compodoc's generated API reference. `pnpm docs:api` rebuilds it from the sources; the
# hand-written documentation under docs/ links into it by symbol name.
docs/api/

# The documentation site's build output and the Compodoc copy it serves.
.vitepress/dist/
.vitepress/cache/
.vitepress/public/

# Slice 70 reproducible, commit-keyed visual audit artifacts.
apps/e2e/ux-output/
