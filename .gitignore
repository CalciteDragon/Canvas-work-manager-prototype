# Dependencies
node_modules/

# Build output
dist/
out-tsc/
.angular/
apps/web/storybook-static/

# The live prototype working file. Seeds under prototype/seeds/ ARE committed;
# this file is regenerated by `pnpm prototype:reset` (Slice 4).
.prototype/data.json

# What `pnpm prototype:upgrade` leaves beside a converted file. The copy is deliberate and
# worth keeping locally; it is nobody else's to review.
.prototype/*.backup-*.json

# The end-to-end suite's own data file and Playwright's output. The suite runs the host
# against this file, never against the developer's workspace.
.prototype/e2e-data.json
apps/e2e/test-results/
apps/e2e/playwright-report/

# Editors / OS
.idea/
.DS_Store
Thumbs.db
*.log
