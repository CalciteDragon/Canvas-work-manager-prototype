{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prototype",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 4200
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:web"
      ],
      "port": 4200
    },
    {
      "name": "host",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@cwm/prototype-host",
        "start"
      ],
      "port": 4310
    }
  ]
}
